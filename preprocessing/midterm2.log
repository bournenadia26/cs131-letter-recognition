    #q14
   40  normalize() {col=$1; infile=$2; outfile=$3; min=$(awk -F, -v col="$col" 'NR>1 {if($col<a) a=$col} END{print a}' a=100000 "$infile"); max=$(awk -F, -v col="$col" 'NR>1 {if($col>a) a=$col} END{print a}' a=-100000 "$infile"); awk -F, -v OFS=',' -v col="$col" -v min="$min" -v max="$max" 'NR==1{print; next} {
    $col=($col-min)/(max-min)
    print
  }' "$infile" > "$outfile"; }
